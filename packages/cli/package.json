{
  "name": "collision",
  "version": "0.1.0",
  "description": "Open-source harness for devtool install agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "collision": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@collision/core": "workspace:*",
    "@collision/detect": "workspace:*",
    "@collision/tui": "workspace:*"
  }
}
