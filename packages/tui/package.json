{
  "name": "@collision/tui",
  "version": "0.1.0",
  "description": "Interactive Ink terminal UI host for Collision install agents",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
