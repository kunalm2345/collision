      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@collision/core": "workspace:*",
    "@collision/detect": "workspace:*",
    "ink": "^6.0.0",
    "react": "^19.1.0"
  }
}
